# GitHub Personal Access Token
# Required scope (classic PAT): repo
# Or fine-grained PAT with: Administration (read/write) on the target repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target repository (owner/repo)
GITHUB_REPO=Boa-Thomas/Sistema-FP

# Runner labels (comma separated, applied to all runners in addition to wsl2-N)
RUNNER_LABELS=self-hosted,linux,x64,wsl2

# Runner work directory name (relative to each runner folder)
RUNNER_WORKDIR=_work

# Default group (usually "default" for repo runners)
RUNNER_GROUP=default

# Maximum concurrent runners on this host (enforced by 'runner-mgr up').
# Set based on available RAM — run 'runner-mgr capacity' for guidance.
# Use 0 or leave unset to disable the cap. Pass --force to 'runner-mgr up'
# to override temporarily.
MAX_RUNNERS=4

# Per-runner cgroup memory ceiling (requires systemd as PID 1 + cgroup v2).
# A job exceeding the limit is OOM-killed in isolation rather than thrashing
# every concurrent runner on the host. Leave empty to disable.
# Sizing: needs to cover the heaviest job class (frontend vitest with thread
# workers + --max-old-space-size=4096 creates 10+ node processes; peak ~4GB).
# INVARIANT: MAX_RUNNERS × RUNNER_MEMORY_MAX + ~2GB OS reserve must be <= the
# WSL2 VM memory (see .wslconfig). 4 × 4096M = 16GB + 2GB = 18GB <= 20GB VM.
# 'runner-mgr up' and 'runner-mgr capacity' enforce/verify this.
RUNNER_MEMORY_MAX=4096M

# --- Queue monitor (runner-mgr queue-check / install-queue-monitor) ---
# ntfy topic for push alerts on a stuck queue / failing runners. Subscribe to
# this exact topic in the ntfy app (https://ntfy.sh) or web to receive them.
# Treat it like a secret — anyone who knows the topic can read/post to it.
# Leave empty to log only (no push).
NTFY_TOPIC=
# ntfy server (self-hosted supported). Default is the public https://ntfy.sh
NTFY_SERVER=https://ntfy.sh
# Optional bearer token if your ntfy topic requires auth.
NTFY_TOKEN=
# Seconds the queue must stay full (0 idle runners) before it counts as stuck.
QMON_STUCK_SECS=1500
