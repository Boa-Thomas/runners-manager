#!/usr/bin/env bash
# runner-mgr — manage GitHub Actions self-hosted runners on this machine.
#
# Usage:  runner-mgr <command> [args]
# Run    `runner-mgr help`  for details.

set -euo pipefail

RM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export RM_ROOT

# shellcheck disable=SC1091
source "$RM_ROOT/lib/common.sh"
# shellcheck disable=SC1091
source "$RM_ROOT/lib/github.sh"
# shellcheck disable=SC1091
source "$RM_ROOT/lib/runner.sh"
# shellcheck disable=SC1091
source "$RM_ROOT/lib/monitor.sh"
# shellcheck disable=SC1091
source "$RM_ROOT/lib/watchdog.sh"
# shellcheck disable=SC1091
source "$RM_ROOT/lib/qmon.sh"

require_cmd jq curl tar sha256sum realpath

cmd_help() {
  cat <<EOF
${C_BOLD}runner-mgr${C_RESET} — GitHub Actions self-hosted runner manager
                       ${C_DIM}repo: ${GITHUB_REPO:-(not configured)}${C_RESET}

${C_BOLD}USAGE${C_RESET}
  runner-mgr <command> [args]

${C_BOLD}COMMANDS${C_RESET}
  ${C_CYAN}setup${C_RESET}                   Interactive first-time configuration (PAT + repo)
  ${C_CYAN}up${C_RESET} [N] [--force]        Start N new runners (default: 1). --force bypasses MAX_RUNNERS cap.
  ${C_CYAN}down${C_RESET} <id|all>           Stop and unregister runner(s)
  ${C_CYAN}stop${C_RESET} <id|all>           Stop process but keep registration
  ${C_CYAN}start${C_RESET} <id|all>          Start a previously stopped runner
  ${C_CYAN}restart${C_RESET} <id|all>        Stop then start
  ${C_CYAN}status${C_RESET}                  One-shot status snapshot
  ${C_CYAN}monitor${C_RESET} [interval]      Live dashboard (default: 2s refresh)
  ${C_CYAN}watchdog${C_RESET} [interval]     Supervise runners; auto-restart the dead (default: 15s)
  ${C_CYAN}install-service${C_RESET}         Run the watchdog as a systemd --user service (auto-start on boot)
  ${C_CYAN}uninstall-service${C_RESET}       Remove the watchdog service
  ${C_CYAN}logs-watchdog${C_RESET} [-f]      Show the watchdog log
  ${C_CYAN}queue-check${C_RESET}             One-shot: check for a stuck queue / failing runners (logs + ntfy)
  ${C_CYAN}install-queue-monitor${C_RESET}  Run queue-check every 30 min via a systemd --user timer
  ${C_CYAN}uninstall-queue-monitor${C_RESET} Remove the queue-monitor timer
  ${C_CYAN}logs-queue${C_RESET} [-f]         Show the queue-monitor log
  ${C_CYAN}list${C_RESET}                    List runners registered on the repo (raw)
  ${C_CYAN}logs${C_RESET} <id> [-f]          Show runner log (-f to follow)
  ${C_CYAN}clean${C_RESET}                   Remove offline/orphaned runners from GitHub
  ${C_CYAN}update${C_RESET} [version]        Download new runner version into cache
  ${C_CYAN}capacity${C_RESET}                Suggest how many runners fit current free RAM/CPU
  ${C_CYAN}help${C_RESET}                    Show this help

${C_BOLD}EXAMPLES${C_RESET}
  runner-mgr setup                  # first-time config
  runner-mgr up 4                   # spin up 4 runners
  runner-mgr monitor                # live dashboard
  runner-mgr logs 2 -f              # tail runner-2's log
  runner-mgr down all               # tear everything down
  runner-mgr down 3                 # remove runner-3 only

${C_BOLD}WORKFLOW LABELS${C_RESET}
  Each runner gets labels: ${C_DIM}\${RUNNER_LABELS},wsl2-<id>${C_RESET}
  Target a specific runner in a workflow:
    ${C_DIM}runs-on: [self-hosted, wsl2-1]${C_RESET}
  Or any free runner:
    ${C_DIM}runs-on: [self-hosted, wsl2]${C_RESET}

${C_BOLD}SIZING VARIABLES${C_RESET} (set in .env)
  ${C_CYAN}MAX_RUNNERS${C_RESET}=N             Hard cap on concurrent runners (default: unlimited).
                              run-mgr up refuses to exceed it; pass --force to override.
  ${C_CYAN}RUNNER_MEMORY_MAX${C_RESET}=<size>  Per-runner cgroup memory ceiling (e.g. 2500M).
                              Requires systemd as PID 1 + cgroup v2. A job exceeding
                              the cap is OOM-killed in isolation rather than thrashing
                              its neighbours. Run 'runner-mgr capacity' for guidance.

${C_BOLD}ISOLAMENTO${C_RESET} (set in .env — veja SECURITY.md)
  ${C_CYAN}RUNNER_EPHEMERAL${C_RESET}=1         Runner atende UM job e se desregistra (padrao: 1).
                              E a fronteira entre jobs. Desligar so com motivo.
  ${C_CYAN}RUNNER_WIPE_WORK${C_RESET}=1         Limpa o _work entre jobs (padrao: 1). Custa cache
                              local de build.
  ${C_CYAN}RUNNER_SKIP_CHECKSUM${C_RESET}=0     Pula a verificacao SHA256 do tarball do runner.
                              Nao ligue: o tarball e executado.
EOF
}

cmd_setup() {
  echo "${C_BOLD}runner-mgr setup${C_RESET}"
  echo
  local token repo labels
  if [[ -f "$RM_ENV" ]]; then
    log_warn "$RM_ENV already exists. Re-running will overwrite it."
    read -rp "Continue? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { log_info "Aborted."; exit 0; }
  fi

  # -s: sem eco. Antes o PAT ficava visivel na tela, no scrollback e em
  # qualquer gravacao de sessao (script, asciinema, screen share).
  read -rsp "GitHub Personal Access Token (scope: repo): " token
  echo
  [[ -n "$token" ]] || die "Token required."

  read -rp "Target repo (owner/name) [Boa-Thomas/Sistema-FP]: " repo
  repo="${repo:-Boa-Thomas/Sistema-FP}"

  read -rp "Extra labels (comma separated) [self-hosted,linux,x64,wsl2]: " labels
  labels="${labels:-self-hosted,linux,x64,wsl2}"

  # Cria o arquivo JA restrito. Fazer `cat > ...` e so depois `chmod 600` deixa
  # uma janela em que o PAT esta 644 — legivel por qualquer usuario da maquina.
  install -m 600 /dev/null "$RM_ENV" || die "Nao consegui criar $RM_ENV"
  cat > "$RM_ENV" <<EOF
GITHUB_TOKEN=$token
GITHUB_REPO=$repo
RUNNER_LABELS=$labels
RUNNER_WORKDIR=_work
RUNNER_GROUP=default

# Maximum concurrent runners on this host (enforced by 'runner-mgr up').
# Adjust to your available RAM. Run 'runner-mgr capacity' for guidance.
MAX_RUNNERS=4
# Per-runner cgroup memory ceiling. Requires systemd as PID 1 + cgroup v2.
# Must cover the heaviest job's peak (frontend vitest --max-old-space-size=4096
# ~= 4GB). INVARIANT: MAX_RUNNERS × RUNNER_MEMORY_MAX + ~2GB OS <= WSL2 VM RAM.
RUNNER_MEMORY_MAX=4096M
EOF
  chmod 600 "$RM_ENV"

  load_env || die "Nao consegui reler $RM_ENV"
  log_info "Validating token + repo access..."
  gh_validate_auth
  warn_if_public_repo
  log_ok "Setup complete. Run: runner-mgr up 4"
}

cmd_capacity() {
  # Load .env if available so we can show current vs. suggested values.
  if [[ -f "${RM_ENV:-}" ]]; then
    load_env 2>/dev/null || true
  fi

  local cpus total_mib reserve cap cap_mib usable fit cpu_cap rec
  cpus=$(nproc)
  total_mib=$(free -m | awk '/^Mem:/ {print $2}')
  reserve=$MEM_OS_RESERVE_MIB

  # RAM is the binding constraint for this CI (heavy Jest/vitest + Docker), so
  # size by memory first, then sanity-cap on CPU. Use the configured per-runner
  # cap (or a 4096M default that covers the heaviest job) as the divisor.
  cap="${RUNNER_MEMORY_MAX:-4096M}"
  cap_mib=$(mem_to_mib "$cap"); (( cap_mib > 0 )) || cap_mib=4096
  usable=$(( total_mib - reserve )); (( usable < 0 )) && usable=0
  fit=$(( usable / cap_mib ))
  # CPU sanity: a heavy CI job uses ~2-4 vCPU; don't schedule more runners than
  # half the cores or they thrash the scheduler.
  cpu_cap=$(( cpus / 2 )); (( cpu_cap < 1 )) && cpu_cap=1
  rec=$fit; (( cpu_cap < rec )) && rec=$cpu_cap
  (( rec < 1 )) && rec=1

  printf '%sCapacity estimate%s — %d CPUs, %d MiB total VM RAM (reserve %d MiB for OS)\n' \
    "$C_BOLD" "$C_RESET" "$cpus" "$total_mib" "$reserve"
  printf '  Per-runner cap %s%s%s (%d MiB) → RAM fits %s%d%s runners; CPU allows %s%d%s\n' \
    "$C_BOLD" "$cap" "$C_RESET" "$cap_mib" "$C_GREEN" "$fit" "$C_RESET" "$C_GREEN" "$cpu_cap" "$C_RESET"
  echo
  printf '  %sRecommended: MAX_RUNNERS=%d  RUNNER_MEMORY_MAX=%s%s\n' "$C_BOLD" "$rec" "$cap" "$C_RESET"
  printf '  %sInvariant: MAX_RUNNERS × RUNNER_MEMORY_MAX + %dMiB OS ≤ %dMiB VM%s\n' \
    "$C_DIM" "$reserve" "$total_mib" "$C_RESET"

  if [[ -n "${MAX_RUNNERS:-}" && -n "${RUNNER_MEMORY_MAX:-}" ]]; then
    echo
    printf '  %sCurrent .env: MAX_RUNNERS=%s  RUNNER_MEMORY_MAX=%s%s\n' \
      "$C_DIM" "$MAX_RUNNERS" "$RUNNER_MEMORY_MAX" "$C_RESET"
    local rc=0
    memory_budget_check "$MAX_RUNNERS" || rc=$?
    if (( rc == 0 )); then
      printf '    %s✓ fits: needs %d MiB of %d MiB VM%s\n' "$C_GREEN" "$MB_NEED" "$MB_TOTAL" "$C_RESET"
    elif (( rc == 1 )); then
      printf '    %s✗ OVERSUBSCRIBED: needs %d MiB but VM has %d MiB — will OOM under load%s\n' \
        "$C_RED" "$MB_NEED" "$MB_TOTAL" "$C_RESET"
    fi
  fi
}

cmd_up() {
  require_env
  gh_validate_auth
  warn_if_public_repo

  # Parse optional --force flag (may appear before or after N).
  local force=0 n=""
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      *)       n="$arg" ;;
    esac
  done
  n="${n:-1}"
  [[ "$n" =~ ^[0-9]+$ ]] || die "up: expected a number, got '$n'"
  (( n > 0 )) || die "up: N must be > 0"

  # Enforce MAX_RUNNERS cap (set in .env). Prevents accidental oversubscription
  # of host RAM when many concurrent CI jobs run simultaneously.
  local current
  current=$(list_local_runners | wc -l)
  local projected=$((current + n))

  local max="${MAX_RUNNERS:-0}"
  if (( max > 0 )); then
    if (( projected > max )); then
      if (( ! force )); then
        die "up: would start ${projected} runners but MAX_RUNNERS=${max} (currently ${current}). " \
            "Remove runners first ('runner-mgr down'), check 'runner-mgr capacity', or pass --force to override."
      else
        log_warn "Overriding MAX_RUNNERS=${max} cap (--force). Will have ${projected} total runners."
      fi
    fi
  fi

  # Memory-budget preflight: projected × RUNNER_MEMORY_MAX + OS reserve must fit
  # VM RAM, else concurrent heavy jobs OOM-kill each other. This is the failure
  # mode that made runs flaky (14GB of caps on a 12GB VM). rc: 0=fits 1=over 2=n/a
  local budget_rc=0
  memory_budget_check "$projected" || budget_rc=$?
  if (( budget_rc == 1 )); then
    log_warn "Memory budget: ${projected} × ${RUNNER_MEMORY_MAX} + ${MEM_OS_RESERVE_MIB}MiB OS = ${MB_NEED}MiB needed, but VM has only ${MB_TOTAL}MiB."
    log_warn "This oversubscribes RAM and invites OOM kills. Lower MAX_RUNNERS/RUNNER_MEMORY_MAX, or raise the WSL2 VM (.wslconfig) — run 'runner-mgr capacity'."
    (( force )) || die "up: refusing to oversubscribe memory. Pass --force to override."
    log_warn "Proceeding despite oversubscription (--force)."
  fi

  log_info "Provisioning $n runner(s)..."
  local i id
  for ((i=1; i<=n; i++)); do
    id=$(next_runner_id)
    provision_runner "$id"
  done
  echo
  cmd_status
}

cmd_down() {
  require_env
  local target="${1:-}"
  [[ -n "$target" ]] || die "down: usage — runner-mgr down <id|all>"

  if [[ "$target" == "all" ]]; then
    local ids; ids=$(list_local_runners)
    [[ -n "$ids" ]] || { log_info "No runners to remove."; return; }
    for id in $ids; do remove_runner "$id"; done
  else
    # Valida ANTES do teste `[[ -d ]]`: com o ID cru, `down '1/../../vitima'`
    # passava no teste e o rm -rf saia de runners/.
    require_runner_id "$target"
    [[ -d "$(runner_dir "$target")" ]] || die "Unknown runner id: $target"
    remove_runner "$target"
  fi
}

cmd_stop() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "stop: usage — runner-mgr stop <id|all>"
  if [[ "$target" == "all" ]]; then
    for id in $(list_local_runners); do stop_runner "$id"; done
  else
    require_runner_id "$target"
    stop_runner "$target"
  fi
}

cmd_start() {
  require_env  # needed for RUNNER_MEMORY_MAX
  local target="${1:-}"
  [[ -n "$target" ]] || die "start: usage — runner-mgr start <id|all>"
  if [[ "$target" == "all" ]]; then
    for id in $(list_local_runners); do start_runner "$id"; done
  else
    require_runner_id "$target"
    start_runner "$target"
  fi
}

cmd_restart() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "restart: usage — runner-mgr restart <id|all>"
  cmd_stop "$target"
  cmd_start "$target"  # cmd_start calls require_env
}

cmd_status() {
  render_status
}

cmd_monitor() {
  live_monitor "${1:-2}"
}

cmd_watchdog() {
  watchdog_loop "${1:-15}"
}

# Install a systemd --user service that runs the watchdog on boot and keeps it
# alive. Enables linger so it survives logout / starts after `wsl --shutdown`.
cmd_install_service() {
  systemd_run_available || die "install-service needs systemd as PID 1 (WSL2 with systemd=true)."
  local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  local unit_file="$unit_dir/runner-mgr-watchdog.service"
  local self; self="$(readlink -f "${BASH_SOURCE[0]}")"
  mkdir -p "$unit_dir"
  cat > "$unit_file" <<EOF
[Unit]
Description=runner-mgr watchdog — keeps GitHub Actions self-hosted runners alive
After=default.target

[Service]
Type=simple
ExecStart=${self} watchdog 15
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF
  log_ok "Wrote $unit_file"
  systemctl --user daemon-reload
  systemctl --user enable --now runner-mgr-watchdog.service
  log_ok "Enabled + started runner-mgr-watchdog.service"
  if loginctl enable-linger "$USER" 2>/dev/null; then
    log_ok "Linger enabled — watchdog will auto-start on boot (survives wsl --shutdown)."
  else
    log_warn "Could not enable linger automatically. Run: sudo loginctl enable-linger $USER"
    log_warn "Without it the watchdog won't auto-start until you open a WSL shell after boot."
  fi
  log_info "Follow it with: journalctl --user -u runner-mgr-watchdog -f   (or: runner-mgr logs-watchdog)"
}

cmd_uninstall_service() {
  systemctl --user disable --now runner-mgr-watchdog.service 2>/dev/null || true
  rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/runner-mgr-watchdog.service"
  systemctl --user daemon-reload 2>/dev/null || true
  log_ok "Removed runner-mgr-watchdog.service"
}

cmd_logs_watchdog() {
  local log; log="$(watchdog_log_file)"
  [[ -f "$log" ]] || die "No watchdog log yet at $log"
  if [[ "${1:-}" == "-f" ]]; then tail -f "$log"; else tail -n 100 "$log"; fi
}

cmd_queue_check() {
  qmon_check
}

cmd_logs_queue() {
  local log; log="$(qmon_log_file)"
  [[ -f "$log" ]] || die "No queue-monitor log yet at $log — run: runner-mgr queue-check"
  if [[ "${1:-}" == "-f" ]]; then tail -f "$log"; else tail -n 100 "$log"; fi
}

# Install a systemd --user timer that runs queue-check every 30 minutes.
cmd_install_queue_monitor() {
  systemd_run_available || die "install-queue-monitor needs systemd as PID 1 (WSL2 with systemd=true)."
  [[ -n "${NTFY_TOPIC:-}" ]] || log_warn "NTFY_TOPIC is unset in .env — the monitor will log but not push. Set it to get alerts."
  local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  local self; self="$(readlink -f "${BASH_SOURCE[0]}")"
  mkdir -p "$unit_dir"
  cat > "$unit_dir/runner-mgr-queue.service" <<EOF
[Unit]
Description=runner-mgr queue monitor — alert on a stuck queue / failing runners

[Service]
Type=oneshot
ExecStart=${self} queue-check
TimeoutStartSec=180
# Este servico so faz chamada de API e escreve log/state — nao precisa de mais
# nada. (O watchdog nao leva o mesmo tratamento: ele sobe os runners.)
NoNewPrivileges=true
PrivateTmp=true
EOF
  cat > "$unit_dir/runner-mgr-queue.timer" <<EOF
[Unit]
Description=Run runner-mgr queue-check every 30 minutes

[Timer]
OnBootSec=3min
OnCalendar=*:0/30
Persistent=true

[Install]
WantedBy=timers.target
EOF
  log_ok "Wrote runner-mgr-queue.service + .timer to $unit_dir"
  systemctl --user daemon-reload
  systemctl --user enable --now runner-mgr-queue.timer
  log_ok "Enabled + started runner-mgr-queue.timer (every :00 and :30)"
  if loginctl enable-linger "$USER" 2>/dev/null; then
    log_ok "Linger enabled — timer survives logout / wsl --shutdown."
  else
    log_warn "Could not enable linger. Run: sudo loginctl enable-linger $USER"
  fi
  log_info "Next runs: systemctl --user list-timers runner-mgr-queue.timer"
  log_info "Log: runner-mgr logs-queue -f"
}

cmd_uninstall_queue_monitor() {
  systemctl --user disable --now runner-mgr-queue.timer 2>/dev/null || true
  rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/runner-mgr-queue.timer" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/runner-mgr-queue.service"
  systemctl --user daemon-reload 2>/dev/null || true
  log_ok "Removed runner-mgr-queue.timer + .service"
}

cmd_list() {
  require_env
  local json; json=$(gh_list_runners) || die "list: nao consegui consultar a API do GitHub"
  printf '%s' "$json" | jq -r '
    ["ID","NAME","STATUS","BUSY","LABELS"],
    (.[] | [
      .id,
      .name,
      .status,
      (.busy|tostring),
      (.labels | map(.name) | join(","))
    ]) | @tsv
  ' | column -t -s $'\t'
}

cmd_logs() {
  local id="${1:-}" follow="${2:-}"
  [[ -n "$id" ]] || die "logs: usage — runner-mgr logs <id> [-f]"
  # Sem isto, `logs '../../../../var/log/algum'` saia de logs/.
  require_runner_id "$id"
  local log; log=$(runner_log "$id")
  [[ -f "$log" ]] || die "No log file for runner-$id"
  if [[ "$follow" == "-f" ]]; then
    tail -f "$log"
  else
    tail -n 100 "$log"
  fi
}

cmd_clean() {
  require_env
  log_info "Removing offline runners from GitHub..."
  local count=0 listing
  listing=$(gh_list_runners) \
    || die "clean: nao consegui listar os runners no GitHub — abortando (nada foi apagado)."

  while IFS=$'\t' read -r gid name status; do
    [[ "$status" == "offline" ]] || continue
    log_info "Deleting offline: $name (id=$gid)"
    if gh_delete_runner "$gid"; then count=$((count+1)); fi
  done < <(printf '%s' "$listing" | jq -r '.[] | [.id, .name, .status] | @tsv')

  log_info "Cleaning up local runner dirs without process or registration..."
  local id
  for id in $(list_local_runners); do
    if runner_is_running "$id"; then continue; fi

    local name; name=$(runner_state_get "$id" "name") || true
    [[ -n "$name" ]] || continue

    # ATENCAO — caminho destrutivo decidido por resposta de API.
    #
    # A versao antiga nao conseguia distinguir "o GitHub nao conhece este
    # runner" de "a chamada falhou": `gh_curl` nao checava status HTTP, entao um
    # body de erro (rate limit, 403, rede) virava `[]` no jq e o runner
    # registrado-e-parado era tratado como orfao — diretorio apagado, registro
    # pendurado. Precisou de uma confirmacao dupla so para contornar isso.
    # Agora `gh_runner_id_by_name` devolve != 0 quando a chamada nao deu certo,
    # e a distincao e explicita.
    local gh_id
    if ! gh_id=$(gh_runner_id_by_name "$name"); then
      log_warn "runner-$id: API do GitHub indisponivel — mantendo o diretorio por seguranca."
      continue
    fi
    [[ -z "$gh_id" ]] || continue

    log_info "Removing orphan local runner-$id"
    safe_rm_runner_dir "$(runner_dir "$id")"
    rm -f "$(runner_state_file "$id")" "$(runner_pidfile "$id")"
    count=$((count+1))
  done

  # Diretorio fora do padrao em runners/ nunca vira ID (list_local_runners
  # filtra), mas merece ser dito em voz alta: um job de CI tem escrita ali, e
  # nome com metacaractere de shell era exatamente o vetor de RCE no watchdog.
  local bogus; bogus="$(list_bogus_runner_dirs)"
  if [[ -n "$bogus" ]]; then
    log_warn "Diretorios em ${RM_RUNNERS} fora do padrao runner-<numero> (ignorados, nao apagados):"
    printf '%s\n' "$bogus" | sed 's/^/    /' >&2
    log_warn "Se voce nao criou esses, trate como indicio de comprometimento — veja SECURITY.md."
  fi

  log_ok "Cleaned $count entries"
}

cmd_update() {
  local version="${1:-}"
  ensure_runner_tarball "$version" >/dev/null
}

main() {
  local cmd="${1:-help}"
  shift || true

  # Commands that don't need .env loaded yet:
  case "$cmd" in
    help|-h|--help) cmd_help; return ;;
    setup)          cmd_setup "$@"; return ;;
    capacity)       cmd_capacity "$@"; return ;;
    logs)           cmd_logs "$@"; return ;;
    logs-watchdog)  cmd_logs_watchdog "$@"; return ;;
    logs-queue)     cmd_logs_queue "$@"; return ;;
    uninstall-service) cmd_uninstall_service "$@"; return ;;
    uninstall-queue-monitor) cmd_uninstall_queue_monitor "$@"; return ;;
    stop|start|restart) "cmd_${cmd}" "$@"; return ;;
  esac

  # All others need config:
  require_env

  case "$cmd" in
    up)       cmd_up "$@" ;;
    down)     cmd_down "$@" ;;
    status)   cmd_status "$@" ;;
    monitor)  cmd_monitor "$@" ;;
    watchdog) cmd_watchdog "$@" ;;
    install-service)   cmd_install_service "$@" ;;
    queue-check)       cmd_queue_check "$@" ;;
    install-queue-monitor) cmd_install_queue_monitor "$@" ;;
    list)     cmd_list "$@" ;;
    clean)    cmd_clean "$@" ;;
    update)   cmd_update "$@" ;;
    *)        log_error "Unknown command: $cmd"; cmd_help; exit 1 ;;
  esac
}

main "$@"
