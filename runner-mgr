#!/usr/bin/env bash
# runner-mgr — manage GitHub Actions self-hosted runners on this machine.
#
# Usage:  runner-mgr <command> [args]
# Run    `runner-mgr help`  for details.

set -euo pipefail

RM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export RM_ROOT

# shellcheck disable=SC1091
source "$RM_ROOT/lib/common.sh"
# shellcheck disable=SC1091
source "$RM_ROOT/lib/github.sh"
# shellcheck disable=SC1091
source "$RM_ROOT/lib/runner.sh"
# shellcheck disable=SC1091
source "$RM_ROOT/lib/monitor.sh"

require_cmd jq curl tar

cmd_help() {
  cat <<EOF
${C_BOLD}runner-mgr${C_RESET} — GitHub Actions self-hosted runner manager
                       ${C_DIM}repo: ${GITHUB_REPO:-(not configured)}${C_RESET}

${C_BOLD}USAGE${C_RESET}
  runner-mgr <command> [args]

${C_BOLD}COMMANDS${C_RESET}
  ${C_CYAN}setup${C_RESET}                   Interactive first-time configuration (PAT + repo)
  ${C_CYAN}up${C_RESET} [N] [--force]        Start N new runners (default: 1). --force bypasses MAX_RUNNERS cap.
  ${C_CYAN}down${C_RESET} <id|all>           Stop and unregister runner(s)
  ${C_CYAN}stop${C_RESET} <id|all>           Stop process but keep registration
  ${C_CYAN}start${C_RESET} <id|all>          Start a previously stopped runner
  ${C_CYAN}restart${C_RESET} <id|all>        Stop then start
  ${C_CYAN}status${C_RESET}                  One-shot status snapshot
  ${C_CYAN}monitor${C_RESET} [interval]      Live dashboard (default: 2s refresh)
  ${C_CYAN}list${C_RESET}                    List runners registered on the repo (raw)
  ${C_CYAN}logs${C_RESET} <id> [-f]          Show runner log (-f to follow)
  ${C_CYAN}clean${C_RESET}                   Remove offline/orphaned runners from GitHub
  ${C_CYAN}update${C_RESET} [version]        Download new runner version into cache
  ${C_CYAN}capacity${C_RESET}                Suggest how many runners fit current free RAM/CPU
  ${C_CYAN}help${C_RESET}                    Show this help

${C_BOLD}EXAMPLES${C_RESET}
  runner-mgr setup                  # first-time config
  runner-mgr up 4                   # spin up 4 runners
  runner-mgr monitor                # live dashboard
  runner-mgr logs 2 -f              # tail runner-2's log
  runner-mgr down all               # tear everything down
  runner-mgr down 3                 # remove runner-3 only

${C_BOLD}WORKFLOW LABELS${C_RESET}
  Each runner gets labels: ${C_DIM}\${RUNNER_LABELS},wsl2-<id>${C_RESET}
  Target a specific runner in a workflow:
    ${C_DIM}runs-on: [self-hosted, wsl2-1]${C_RESET}
  Or any free runner:
    ${C_DIM}runs-on: [self-hosted, wsl2]${C_RESET}

${C_BOLD}SIZING VARIABLES${C_RESET} (set in .env)
  ${C_CYAN}MAX_RUNNERS${C_RESET}=N             Hard cap on concurrent runners (default: unlimited).
                              run-mgr up refuses to exceed it; pass --force to override.
  ${C_CYAN}RUNNER_MEMORY_MAX${C_RESET}=<size>  Per-runner cgroup memory ceiling (e.g. 2500M).
                              Requires systemd as PID 1 + cgroup v2. A job exceeding
                              the cap is OOM-killed in isolation rather than thrashing
                              its neighbours. Run 'runner-mgr capacity' for guidance.
EOF
}

cmd_setup() {
  echo "${C_BOLD}runner-mgr setup${C_RESET}"
  echo
  local token repo labels
  if [[ -f "$RM_ENV" ]]; then
    log_warn "$RM_ENV already exists. Re-running will overwrite it."
    read -rp "Continue? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { log_info "Aborted."; exit 0; }
  fi

  read -rp "GitHub Personal Access Token (scope: repo): " token
  [[ -n "$token" ]] || die "Token required."

  read -rp "Target repo (owner/name) [Boa-Thomas/Sistema-FP]: " repo
  repo="${repo:-Boa-Thomas/Sistema-FP}"

  read -rp "Extra labels (comma separated) [self-hosted,linux,x64,wsl2]: " labels
  labels="${labels:-self-hosted,linux,x64,wsl2}"

  cat > "$RM_ENV" <<EOF
GITHUB_TOKEN=$token
GITHUB_REPO=$repo
RUNNER_LABELS=$labels
RUNNER_WORKDIR=_work
RUNNER_GROUP=default

# Maximum concurrent runners on this host (enforced by 'runner-mgr up').
# Adjust to your available RAM. Run 'runner-mgr capacity' for guidance.
MAX_RUNNERS=4
# Per-runner cgroup memory ceiling. Requires systemd as PID 1 + cgroup v2.
# 4 runners × 2500M = 10GB, leaving ~2GB headroom on a 12GB host.
RUNNER_MEMORY_MAX=2500M
EOF
  chmod 600 "$RM_ENV"

  set -a; source "$RM_ENV"; set +a
  log_info "Validating token + repo access..."
  gh_validate_auth
  log_ok "Setup complete. Run: runner-mgr up 4"
}

cmd_capacity() {
  # Load .env if available so we can show current vs. suggested values.
  if [[ -f "${RM_ENV:-}" ]]; then
    set -a; source "$RM_ENV" 2>/dev/null || true; set +a
  fi

  local cpus mem_total_mb mem_free_mb
  cpus=$(nproc)
  mem_total_mb=$(free -m | awk '/^Mem:/ {print $2}')
  mem_free_mb=$(free -m  | awk '/^Mem:/ {print $7}')

  # Reserve ~4 cores and 2 GB for the OS + runner agent overhead.
  local usable_cpus usable_mem
  usable_cpus=$(( cpus - 4 )); (( usable_cpus < 1 )) && usable_cpus=1
  usable_mem=$(( mem_free_mb - 2048 )); (( usable_mem < 1024 )) && usable_mem=1024

  # Per-runner footprints calibrated for this CI workload:
  #   Heavy  — Docker + Postgres + Jest (backend-tests shard): ~2.5 GB
  #   Medium — Node/Py/Go without containers:                  ~1.5 GB
  #   Light  — lint / deploy / IO only:                        ~512 MB
  local heavy med light
  heavy=$(( usable_cpus / 4 ))
  med=$(( usable_cpus / 2 ))
  light=$usable_cpus
  local heavy_m med_m light_m
  heavy_m=$(( usable_mem / 2560 ))
  med_m=$(( usable_mem / 1536 ))
  light_m=$(( usable_mem / 512 ))
  (( heavy_m < heavy )) && heavy=$heavy_m
  (( med_m   < med   )) && med=$med_m
  (( light_m < light )) && light=$light_m

  printf '%sCapacity estimate%s — %d CPUs, %d/%d MiB free/total RAM\n' \
    "$C_BOLD" "$C_RESET" "$cpus" "$mem_free_mb" "$mem_total_mb"
  printf '  %sHeavy jobs%s  (Docker+Postgres CI):  %s%d runners%s  %s(~2.5 GB each)%s\n' \
    "$C_DIM" "$C_RESET" "$C_GREEN" "$heavy" "$C_RESET" "$C_DIM" "$C_RESET"
  printf '  %sMedium jobs%s (Node/Py/Go):           %s%d runners%s  %s(~1.5 GB each)%s\n' \
    "$C_DIM" "$C_RESET" "$C_GREEN" "$med" "$C_RESET" "$C_DIM" "$C_RESET"
  printf '  %sLight jobs%s  (lint/deploy/IO):       %s%d runners%s  %s(~512 MB each)%s\n' \
    "$C_DIM" "$C_RESET" "$C_GREEN" "$light" "$C_RESET" "$C_DIM" "$C_RESET"
  echo
  printf '  %sRecommended for this host (heavy CI): %d runners%s\n' "$C_BOLD" "$heavy" "$C_RESET"
  echo
  printf '  %sSuggested .env settings:%s\n' "$C_DIM" "$C_RESET"
  printf '    MAX_RUNNERS=%d\n' "$heavy"
  printf '    RUNNER_MEMORY_MAX=2500M\n'

  if [[ -n "${MAX_RUNNERS:-}" || -n "${RUNNER_MEMORY_MAX:-}" ]]; then
    echo
    printf '  %sCurrent .env settings:%s\n' "$C_DIM" "$C_RESET"
    [[ -n "${MAX_RUNNERS:-}" ]]       && printf '    MAX_RUNNERS=%s\n' "$MAX_RUNNERS"
    [[ -n "${RUNNER_MEMORY_MAX:-}" ]] && printf '    RUNNER_MEMORY_MAX=%s\n' "$RUNNER_MEMORY_MAX"
  fi
}

cmd_up() {
  require_env
  gh_validate_auth

  # Parse optional --force flag (may appear before or after N).
  local force=0 n=""
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      *)       n="$arg" ;;
    esac
  done
  n="${n:-1}"
  [[ "$n" =~ ^[0-9]+$ ]] || die "up: expected a number, got '$n'"
  (( n > 0 )) || die "up: N must be > 0"

  # Enforce MAX_RUNNERS cap (set in .env). Prevents accidental oversubscription
  # of host RAM when many concurrent CI jobs run simultaneously.
  local max="${MAX_RUNNERS:-0}"
  if (( max > 0 )); then
    local current
    current=$(list_local_runners | wc -l)
    if (( current + n > max )); then
      if (( ! force )); then
        die "up: would start $((current + n)) runners but MAX_RUNNERS=${max} (currently ${current}). " \
            "Remove runners first ('runner-mgr down'), check 'runner-mgr capacity', or pass --force to override."
      else
        log_warn "Overriding MAX_RUNNERS=${max} cap (--force). Will have $((current + n)) total runners."
      fi
    fi
  fi

  log_info "Provisioning $n runner(s)..."
  local i id
  for ((i=1; i<=n; i++)); do
    id=$(next_runner_id)
    provision_runner "$id"
  done
  echo
  cmd_status
}

cmd_down() {
  require_env
  local target="${1:-}"
  [[ -n "$target" ]] || die "down: usage — runner-mgr down <id|all>"

  if [[ "$target" == "all" ]]; then
    local ids; ids=$(list_local_runners)
    [[ -n "$ids" ]] || { log_info "No runners to remove."; return; }
    for id in $ids; do remove_runner "$id"; done
  else
    [[ -d "$(runner_dir "$target")" ]] || die "Unknown runner id: $target"
    remove_runner "$target"
  fi
}

cmd_stop() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "stop: usage — runner-mgr stop <id|all>"
  if [[ "$target" == "all" ]]; then
    for id in $(list_local_runners); do stop_runner "$id"; done
  else
    stop_runner "$target"
  fi
}

cmd_start() {
  require_env  # needed for RUNNER_MEMORY_MAX
  local target="${1:-}"
  [[ -n "$target" ]] || die "start: usage — runner-mgr start <id|all>"
  if [[ "$target" == "all" ]]; then
    for id in $(list_local_runners); do start_runner "$id"; done
  else
    start_runner "$target"
  fi
}

cmd_restart() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "restart: usage — runner-mgr restart <id|all>"
  cmd_stop "$target"
  cmd_start "$target"  # cmd_start calls require_env
}

cmd_status() {
  render_status
}

cmd_monitor() {
  live_monitor "${1:-2}"
}

cmd_list() {
  require_env
  gh_list_runners | jq -r '
    ["ID","NAME","STATUS","BUSY","LABELS"],
    (.[] | [
      .id,
      .name,
      .status,
      (.busy|tostring),
      (.labels | map(.name) | join(","))
    ]) | @tsv
  ' | column -t -s $'\t'
}

cmd_logs() {
  local id="${1:-}" follow="${2:-}"
  [[ -n "$id" ]] || die "logs: usage — runner-mgr logs <id> [-f]"
  local log; log=$(runner_log "$id")
  [[ -f "$log" ]] || die "No log file for runner-$id"
  if [[ "$follow" == "-f" ]]; then
    tail -f "$log"
  else
    tail -n 100 "$log"
  fi
}

cmd_clean() {
  require_env
  log_info "Removing offline runners from GitHub..."
  local count=0
  while IFS=$'\t' read -r id name status; do
    [[ "$status" == "offline" ]] || continue
    log_info "Deleting offline: $name (id=$id)"
    gh_delete_runner "$id"
    count=$((count+1))
  done < <(gh_list_runners | jq -r '.[] | [.id, .name, .status] | @tsv')

  log_info "Cleaning up local runner dirs without process or registration..."
  for id in $(list_local_runners); do
    if ! runner_is_running "$id"; then
      local name; name=$(runner_state_get "$id" "name")
      if [[ -n "$name" ]] && [[ -z "$(gh_runner_id_by_name "$name")" ]]; then
        log_info "Removing orphan local runner-$id"
        rm -rf "$(runner_dir "$id")"
        rm -f "$(runner_state_file "$id")" "$(runner_pidfile "$id")"
        count=$((count+1))
      fi
    fi
  done
  log_ok "Cleaned $count entries"
}

cmd_update() {
  local version="${1:-}"
  ensure_runner_tarball "$version" >/dev/null
}

main() {
  local cmd="${1:-help}"
  shift || true

  # Commands that don't need .env loaded yet:
  case "$cmd" in
    help|-h|--help) cmd_help; return ;;
    setup)          cmd_setup "$@"; return ;;
    capacity)       cmd_capacity "$@"; return ;;
    logs)           cmd_logs "$@"; return ;;
    stop|start|restart) "cmd_${cmd}" "$@"; return ;;
  esac

  # All others need config:
  require_env

  case "$cmd" in
    up)       cmd_up "$@" ;;
    down)     cmd_down "$@" ;;
    status)   cmd_status "$@" ;;
    monitor)  cmd_monitor "$@" ;;
    list)     cmd_list "$@" ;;
    clean)    cmd_clean "$@" ;;
    update)   cmd_update "$@" ;;
    *)        log_error "Unknown command: $cmd"; cmd_help; exit 1 ;;
  esac
}

main "$@"
